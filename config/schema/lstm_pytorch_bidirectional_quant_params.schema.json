{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-lstm.local/schema/lstm_pytorch_bidirectional_quant_params.schema.json",
  "title": "Bidirectional QuantLSTM PyTorch parameter document v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_metadata",
    "quant_params",
    "quant_params_reverse"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "execution_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "activation_mode",
        "cublas_math_mode",
        "standard_scale_mode",
        "bidirectional"
      ],
      "properties": {
        "carrier": {
          "const": "cuda_fp32_qcarrier"
        },
        "activation_mode": {
          "const": "real_sigmoid_tanh"
        },
        "cublas_math_mode": {
          "enum": ["pedantic", "tf32"]
        },
        "standard_scale_mode": {
          "enum": ["affine", "pot2"]
        },
        "bidirectional": {
          "const": true
        }
      }
    },
    "quant_params": {
      "type": "object",
      "description": "Forward canonical lstm_quant_params_bundle payload"
    },
    "quant_params_reverse": {
      "type": "object",
      "description": "Reverse canonical lstm_quant_params_bundle payload"
    }
  }
}
