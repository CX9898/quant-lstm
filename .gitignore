# CMake 和本地编译产物
/build/
/build-*/
/cmake-build-*/
/pytorch/build/
/pytorch/tests/build/

# Python 缓存和本地扩展产物
__pycache__/
*.py[cod]
*.so

# Golden 派生代码：由规范 JSON 在构建或测试时重新生成
/tests/golden/generated/

# 测试、精度与性能报告：每次运行重新生成
/tests/results/
/tests/reports/
/tests/precision/results/
/tests/benchmarks/results/

# 临时调研记录：结论落地到正式文档后不提交调研过程
/docs/research/
