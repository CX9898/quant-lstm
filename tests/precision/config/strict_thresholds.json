{
  "schema_version": 1,
  "validation_scope": "synthetic_numeric",
  "data_layer": "synthetic",
  "tensor_targets": ["output", "h_n", "c_n"],
  "comparison": {
    "mse": "strict_less_than",
    "mae": "strict_less_than",
    "cosine_similarity": "greater_than_or_equal"
  },
  "profiles": {
    "non_quantized": {
      "mse": 1e-5,
      "mae": 0.003,
      "cosine_similarity": 0.9999
    },
    "int8": {
      "mse": 0.001,
      "mae": 0.05,
      "cosine_similarity": 0.999
    },
    "int16": {
      "mse": 0.0001,
      "mae": 0.015,
      "cosine_similarity": 0.999
    }
  },
  "quantized_profile_selection": {
    "source": "minimum_effective_operator_bitwidth",
    "mapping": {"8": "int8", "16": "int16"},
    "excluded_fields": ["carrier", "accumulator", "m_shift", "q31", "diagnostics"],
    "unmapped": "fail_fast"
  }
}
