{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-lstm.local/schema/metric_policy.schema.json",
  "title": "阶段 3 精度指标策略 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "accumulator_dtype",
    "flatten_before_compute",
    "metrics",
    "cosine",
    "tensor_targets",
    "strict_time_step_aggregation"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "accumulator_dtype": {"const": "float64"},
    "flatten_before_compute": {"const": true},
    "metrics": {
      "type": "array",
      "const": ["mae", "mse", "cosine_similarity"]
    },
    "cosine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l2_norm_epsilon", "both_near_zero", "one_near_zero", "statuses"],
      "properties": {
        "l2_norm_epsilon": {"type": "number", "const": 1e-12},
        "both_near_zero": {"const": "not_applicable_use_exact_mae_mse"},
        "one_near_zero": {"const": "fail"},
        "statuses": {
          "type": "array",
          "const": ["valid", "both_near_zero", "one_near_zero"]
        }
      }
    },
    "tensor_targets": {
      "type": "array",
      "const": ["output", "h_n", "c_n"]
    },
    "strict_time_step_aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "case_summary"],
      "properties": {
        "output": {
          "type": "array",
          "const": ["max_mae", "max_mse", "min_valid_cosine", "worst_time_step"]
        },
        "case_summary": {
          "type": "array",
          "const": ["mean", "p50", "p95", "worst", "failed_samples"]
        }
      }
    }
  }
}
