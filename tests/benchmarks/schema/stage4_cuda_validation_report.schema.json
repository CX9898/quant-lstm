{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-lstm.local/schema/stage4_cuda_validation_report.schema.json",
  "title": "Stage 4 CUDA validation 汇总报告",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_id",
    "stage",
    "status",
    "started_at_utc",
    "finished_at_utc",
    "build_dir",
    "artifact_dir",
    "device",
    "environment",
    "benchmark",
    "profile_benchmark",
    "validation",
    "commands",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "config_id": {"const": "cuda_benchmark_v1"},
    "stage": {"type": "integer", "const": 4},
    "status": {"const": "passed"},
    "started_at_utc": {"$ref": "#/$defs/timestamp"},
    "finished_at_utc": {"$ref": "#/$defs/timestamp"},
    "build_dir": {"$ref": "#/$defs/absolute_path"},
    "artifact_dir": {"$ref": "#/$defs/absolute_path"},
    "device": {"type": "integer", "minimum": 0},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu_index",
        "gpu_name",
        "gpu_uuid",
        "driver_version",
        "compute_capability",
        "pstate",
        "graphics_clock_mhz",
        "sm_clock_mhz",
        "memory_clock_mhz",
        "power_draw_w",
        "power_limit_w"
      ],
      "properties": {
        "gpu_index": {"type": "integer", "minimum": 0},
        "gpu_name": {"type": "string", "minLength": 1},
        "gpu_uuid": {"type": "string", "minLength": 1},
        "driver_version": {"type": "string", "minLength": 1},
        "compute_capability": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "pstate": {"type": "string", "pattern": "^P[0-9]+$"},
        "graphics_clock_mhz": {"type": "number", "minimum": 0},
        "sm_clock_mhz": {"type": "number", "minimum": 0},
        "memory_clock_mhz": {"type": "number", "minimum": 0},
        "power_draw_w": {"type": "number", "minimum": 0},
        "power_limit_w": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "benchmark": {"$ref": "cuda_benchmark_result.schema.json"},
    "profile_benchmark": {"$ref": "cuda_benchmark_result.schema.json"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_cublas_sgemm_calls",
        "benchmark_cublas_sgemm_calls",
        "trace_cublas_sgemm_calls",
        "formula",
        "benchmark_matches_expected",
        "trace_matches_expected",
        "benchmark_trace_cross_check"
      ],
      "properties": {
        "expected_cublas_sgemm_calls": {"type": "integer", "minimum": 2},
        "benchmark_cublas_sgemm_calls": {"type": "integer", "minimum": 1},
        "trace_cublas_sgemm_calls": {"type": "integer", "minimum": 1},
        "formula": {"const": "sum_cases(1+T)"},
        "benchmark_matches_expected": {"const": true},
        "trace_matches_expected": {"const": true},
        "benchmark_trace_cross_check": {"const": true}
      }
    },
    "commands": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/command"}
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_report",
        "profile_benchmark_report",
        "memcheck_log",
        "racecheck_log",
        "nsys_report",
        "nsys_sqlite",
        "nsys_stats",
        "validation_report"
      ],
      "properties": {
        "benchmark_report": {"$ref": "#/$defs/absolute_path"},
        "profile_benchmark_report": {"$ref": "#/$defs/absolute_path"},
        "memcheck_log": {"$ref": "#/$defs/absolute_path"},
        "racecheck_log": {"$ref": "#/$defs/absolute_path"},
        "nsys_report": {"$ref": "#/$defs/absolute_path"},
        "nsys_sqlite": {"$ref": "#/$defs/absolute_path"},
        "nsys_stats": {"$ref": "#/$defs/absolute_path"},
        "validation_report": {"$ref": "#/$defs/absolute_path"}
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^/"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "argv",
        "returncode",
        "duration_seconds",
        "stdout_artifact",
        "stderr_artifact"
      ],
      "properties": {
        "step": {
          "enum": [
            "gpu_environment",
            "benchmark",
            "memcheck",
            "racecheck",
            "nsys_profile",
            "nsys_export",
            "nsys_stats"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "returncode": {"type": "integer", "const": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "stdout_artifact": {"$ref": "#/$defs/absolute_path"},
        "stderr_artifact": {"$ref": "#/$defs/absolute_path"}
      }
    }
  }
}
